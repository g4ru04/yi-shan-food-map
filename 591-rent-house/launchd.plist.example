<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  ⚠️ 2026-10-28 15:00 起停止爬取:樂屋網 Cloudflare 擋爬,此排程已從 launchd 卸載,未解決前不要重新安裝。

  591 租屋排程(macOS LaunchAgent,每 5 小時)。把 __REPO__ 換成 repo 絕對路徑後:
    sed "s#__REPO__#$PWD#g" 591-rent-house/launchd.plist.example > ~/Library/LaunchAgents/tw.g4ru04.591-rent-watch.plist
    launchctl load ~/Library/LaunchAgents/tw.g4ru04.591-rent-watch.plist
  每天 0:07、5:07、10:07、15:07、20:07 執行(24 不能被 5 整除,20:07 到隔天 0:07 只隔 4 小時);
  電腦睡眠錯過的那一輪,醒來後會補跑一次。
-->
<plist version="1.0">
<dict>
  <key>Label</key><string>tw.g4ru04.591-rent-watch</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__REPO__/scripts/591-watch.sh</string>
  </array>
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Hour</key><integer>0</integer><key>Minute</key><integer>7</integer></dict>
    <dict><key>Hour</key><integer>5</integer><key>Minute</key><integer>7</integer></dict>
    <dict><key>Hour</key><integer>10</integer><key>Minute</key><integer>7</integer></dict>
    <dict><key>Hour</key><integer>15</integer><key>Minute</key><integer>7</integer></dict>
    <dict><key>Hour</key><integer>20</integer><key>Minute</key><integer>7</integer></dict>
  </array>
  <key>StandardOutPath</key><string>/tmp/591-rent-watch.launchd.log</string>
  <key>StandardErrorPath</key><string>/tmp/591-rent-watch.launchd.log</string>
</dict>
</plist>
