# 591 租屋排程設定:複製到 ~/.config/591-rent/env 後填值(此檔不含任何密鑰,真正的 env 檔不要進 git)
#   mkdir -p ~/.config/591-rent && cp 591-rent-house/env.example ~/.config/591-rent/env && chmod 600 ~/.config/591-rent/env

# launchd / cron 的 PATH 很陽春,要能找到 node(≥18)與 claude
PATH=/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin

# Slack bot token(需要 chat:write、im:write scope);留空則只寫 log 不通知
SLACK_BOT_TOKEN=
# 通知對象的 Slack user id
SLACK_USER_ID=URQHCM761

# 判圖用的 claude 執行檔絕對路徑(`which claude` 查);沒有 claude token 時可改填 bridge-cli 的路徑(`which bridge-cli`),參數相同,下面的 OAUTH_TOKEN 留空即可
CLAUDE_BIN=
# 排程環境讀不到 macOS Keychain 的登入狀態:先跑 `claude setup-token`,把產生的 token 貼在這
CLAUDE_CODE_OAUTH_TOKEN=

# 時間一律以台灣時間顯示
TZ=Asia/Taipei
